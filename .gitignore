# Phụ thuộc và kết quả build — dựng lại được bằng `npm install` và `npm run build`
node_modules/
__pycache__/
*.py[cod]
dist/
*.tsbuildinfo

# Cache của dev server khi bật NSNN_PROXY
.api-cache/

# Hồ sơ tạm của trình duyệt do script kiểm chứng tạo ra
.pptr-*/

# Cấu hình cục bộ
*.local
.DS_Store
Thumbs.db

# Cache tối ưu phụ thuộc của Vite
.vite/

# Bản nén của bộ tham chiếu: toàn bộ 259 file đã nằm sẵn ở reference-nsnn/
# và PROMPT-CLAUDE-NSNN.md, giữ thêm bản nén là giữ hai nguồn cho một nội dung.
/claude-nsnn-reference.zip

# Lệnh ở gốc chỉ uỷ quyền xuống prototype-nsnn/, không có phụ thuộc riêng
/package-lock.json

# Bản tài liệu TMS nội bộ để đọc hoặc đăng Outline có phân quyền
/bao-cao-outline/noi-bo/

# Nguồn Excel bên Thuế: danh bạ 473 nghìn người nộp thuế và các bảng nối gốc.
# Đây là dữ liệu mật, không đưa lên remote. Tài liệu tham chiếu chúng bằng mã
# (TMS-SPEC, MAP-BC, MAP-6334, DANHBA, MLNS), không bằng tên file.
/TMS/*.xls
/TMS/*.xlsx
/TMS/*.XLSX
