{
  "name": "dashboard-nsnn-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Prototype tái tạo nguyên trạng dashboard Thu NSNN Hà Nội theo phường/xã (dev-nsnn.thehegeo.com)",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:tokens && npm run check:docs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "acceptance": "node scripts/acceptance.mjs",
    "check:report-ui": "node scripts/check-report-ui.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^25.10.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  }
}
